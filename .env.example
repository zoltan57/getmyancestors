# Copy this file to .env and fill in real values. .env is gitignored — never
# commit real credentials. All variables are optional; a CLI flag always
# overrides the matching environment variable.

# FamilySearch.org login (fetch)
FS_USERNAME=
FS_PASSWORD=

# Default --db path used by fetch/load/diff when --db is omitted. Pointing
# this at the gitignored data/ directory (see .gitignore) keeps capture
# databases and fetch's auto-generated log files (which land next to --db)
# out of version control without needing a separate setting for either.
# The data/ directory must already exist (create it once if it's missing —
# it's tracked in git only via a data/.gitkeep placeholder).
FS_DB=data/family.sqlite

# Default fetch tuning (fetch only); see `getmyancestors fetch --help`.
FS_RATE_LIMIT=2
FS_TIMEOUT=60
FS_ASCEND=4
FS_DESCEND=0

# Python bytecode
__pycache__/
*.py[cod]

# Build / packaging artifacts (uv build / setuptools)
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Local Python version pin (e.g. from `uv python pin`); this repo's supported
# version lives in pyproject.toml's requires-python/[tool.uv] instead
.python-version

# Test / lint tool caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets (see .env.example for the template; never commit real credentials)
.env

# Editor
.vscode/

# getmyancestors runtime artifacts: capture databases (--db) and fetch log
# files (see README's Logging section) created by running the CLI locally
*.sqlite
*.sqlite3
*.log

# Recommended location for the above (see .env.example's FS_DB) — keep the
# directory itself tracked (via data/.gitkeep) but ignore everything in it
/data/*
!/data/.gitkeep